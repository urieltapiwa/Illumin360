{
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 2592000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername()",
  "realm": "support",
  "displayName": "Illumin360 Support",
  "loginTheme": "illumin360",
  "roles": {
    "realm": [
      {
        "name": "support.l1"
      },
      {
        "name": "support.l2"
      },
      {
        "name": "support.lead"
      }
    ]
  },
  "clients": [
    {
      "clientId": "support-web",
      "name": "Illumin360 Support Portal (MVC)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE_ME_support_dev_secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5197/signin-oidc",
        "http://localhost:5197/signout-callback-oidc"
      ],
      "webOrigins": [
        "http://localhost:5197"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5197/*"
      }
    }
  ],
  "users": [
    {
      "username": "dev.support",
      "enabled": true,
      "email": "dev.support@illumin360.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Support",
      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "support.lead"
      ]
    }
  ]
}