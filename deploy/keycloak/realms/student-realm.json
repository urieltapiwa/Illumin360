{
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 2592000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername()",
  "realm": "student",
  "displayName": "Illumin360 Student",
  "loginTheme": "illumin360",
  "roles": {
    "realm": [
      {
        "name": "client.user"
      },
      {
        "name": "client.student"
      },
      {
        "name": "admin.write",
        "description": "Service-account provisioning role (registration -> domain profile create). Not for human users."
      }
    ]
  },
  "clients": [
    {
      "clientId": "student-web",
      "name": "Illumin360 Student Portal (MVC)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE_ME_student_dev_secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5194/signin-oidc",
        "http://localhost:5194/signout-callback-oidc"
      ],
      "webOrigins": [
        "http://localhost:5194"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5194/*"
      }
    }
  ],
  "users": [
    {
      "username": "dev.student",
      "enabled": true,
      "email": "dev.student@illumin360.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Student",
      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "client.user",
        "client.student"
      ]
    }
  ]
}