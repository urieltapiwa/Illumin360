# Illumin360 local environment defaults. Copy to .env and adjust.
# NEVER commit a real .env. Production secrets live in HashiCorp Vault.

# --- PostgreSQL ---
POSTGRES_USER=illumin
POSTGRES_PASSWORD=illumin_dev_pw
POSTGRES_DB=illumin360
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KC_DB_NAME=keycloak

# --- RabbitMQ ---
RABBITMQ_USER=illumin
RABBITMQ_PASSWORD=illumin
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MinIO (object storage) ---
MINIO_ROOT_USER=illumin
MINIO_ROOT_PASSWORD=illumin12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
