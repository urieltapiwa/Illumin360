{
  "Serilog": { "MinimumLevel": { "Default": "Information" } },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://alloy:4317",
  "ReverseProxy": {
    "Routes": {
      "candidates-route": {
        "ClusterId": "candidates",
        "Match": { "Path": "/api/candidates/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/candidates/{**catch-all}" } ]
      },
      "recruitment-route": {
        "ClusterId": "recruitment",
        "Match": { "Path": "/api/recruitment/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/recruitment/{**catch-all}" } ]
      },
      "careers-route": {
        "ClusterId": "recruitment",
        "Match": { "Path": "/careers/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/recruitment/careers/{**catch-all}" } ]
      },
      "careers-index-route": {
        "ClusterId": "recruitment",
        "Match": { "Path": "/careers" },
        "Transforms": [ { "PathPattern": "/v1/recruitment/careers" } ]
      },
      "students-route": {
        "ClusterId": "students",
        "Match": { "Path": "/api/students/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/students/{**catch-all}" } ]
      },
      "professionals-route": {
        "ClusterId": "professionals",
        "Match": { "Path": "/api/professionals/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/professionals/{**catch-all}" } ]
      },
      "admin-route": {
        "ClusterId": "admin",
        "Match": { "Path": "/api/admin/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/admin/{**catch-all}" } ]
      },
      "employers-route": {
        "ClusterId": "employers",
        "Match": { "Path": "/api/employers/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/employers/{**catch-all}" } ]
      },
      "payments-route": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/v1/payments/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "candidates": {
        "Destinations": { "d1": { "Address": "http://candidates-api:8080/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/ready" } }
      },
      "recruitment": {
        "Destinations": { "d1": { "Address": "http://recruitment-api:8080/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/ready" } }
      },
      "students": {
        "Destinations": { "d1": { "Address": "http://students-api:8080/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/ready" } }
      },
      "professionals": {
        "Destinations": { "d1": { "Address": "http://professionals-api:8080/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/ready" } }
      },
      "admin": {
        "Destinations": { "d1": { "Address": "http://admin-api:8080/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/ready" } }
      },
      "employers": {
        "Destinations": { "d1": { "Address": "http://employers-api:8080/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/ready" } }
      },
      "payments": {
        "Destinations": { "d1": { "Address": "http://payments-api:8080/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/ready" } }
      }
    }
  },
  "AllowedHosts": "*"
}
