<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Illumin360.Security</RootNamespace>
  </PropertyGroup>
  <!-- Shared service-layer authentication/authorization: validates Keycloak JWTs and projects
       realm roles into ASP.NET role claims so services can enforce role policies (charter Part 7/8). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
</Project>
