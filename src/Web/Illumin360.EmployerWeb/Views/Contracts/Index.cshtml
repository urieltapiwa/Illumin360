@model Illumin360.EmployerWeb.Controllers.ContractsListVm
@{
    ViewData["Title"] = "Contracts";
    string StatusCls(string s) => s switch
    {
        "Active" => "bg-soft-success text-success",
        "Draft" => "bg-soft-warning text-warning",
        "Completed" => "bg-soft-primary text-primary",
        "Cancelled" => "bg-soft-danger text-danger",
        _ => "bg-soft-secondary text-secondary",
    };
    var live = Model.ClientId != Guid.Empty;
}

@if (TempData["Msg"] is string msg)
{
    <div class="alert alert-soft-primary py-2 mb-3">@msg</div>
}

<div class="d-flex align-items-center gap-2 mb-3">
    <span class="badge @(live ? "bg-soft-primary text-primary" : "bg-soft-warning text-warning")">@(live ? "Live data" : "Demo data")</span>
    <span class="text-muted small text-on-dark-canvas">Fixed-price contracts and milestone escrow from the Payments service.</span>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-0 h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Contracts</h5>
                <span class="badge bg-soft-primary text-primary">@Model.Contracts.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead><tr><th>Title</th><th>Currency</th><th>Status</th><th>Created</th><th class="text-end">Action</th></tr></thead>
                        <tbody>
                        @if (Model.Contracts.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No contracts yet — create one on the right.</td></tr>
                        }
                        @foreach (var c in Model.Contracts.OrderByDescending(x => x.CreatedAt))
                        {
                            <tr>
                                <td class="fw-semibold">@c.Title</td>
                                <td class="text-muted">@c.Currency</td>
                                <td><span class="badge @StatusCls(c.Status)">@c.Status</span></td>
                                <td class="text-muted">@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end"><a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-soft-primary">Open</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-0 h-100">
            <div class="card-header"><h5 class="mb-0 fw-bold">New contract</h5></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Title</label>
                        <input name="title" class="form-control" placeholder="e.g. Website Redesign" required maxlength="160" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Currency</label>
                        <input name="currency" class="form-control" value="NAD" maxlength="3" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Create draft</button>
                    <p class="text-muted mt-2 mb-0" style="font-size:.75rem;">Add milestones and activate on the next screen.</p>
                </form>
            </div>
        </div>
    </div>
</div>
