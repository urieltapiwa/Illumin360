@model Illumin360.EmployerWeb.Services.EmployerDashboard
@{
    ViewData["Title"] = "Company profile";
    var profile = Model?.Profile;
    var live = profile is not null;
    var rec = Model?.Recruitment;
    var cand = Model?.Candidates;

    // KPIs — Open Roles/Hires from Recruitment, Candidates from the candidate pool, Team from the Employers service.
    var kpis = new (string, string, string, string)[] {
        ("Open Roles", (rec?.OpenRequests ?? 0).ToString(), $"{rec?.FilledRequests ?? 0} filled", "M3 8h18v12H3zM8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"),
        ("Candidates", (cand?.Total ?? 0).ToString(), "in the pool", "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 21a7 7 0 0 1 14 0"),
        ("Team Members", (Model?.TeamCount ?? 0).ToString(), "on this account", "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 21a7 7 0 0 1 14 0"),
        ("Hires", (rec?.TotalHires ?? 0).ToString(), $"of {rec?.TotalApplications ?? 0} applications", "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"),
    };

    // Chart data from the live Recruitment trend/funnel, with a demo fallback when the service is unavailable.
    var trend = rec?.Trend ?? System.Array.Empty<Illumin360.EmployerWeb.Services.MonthlyPoint>();
    var hasTrend = trend.Count > 0;
    var appLabels = hasTrend ? "[" + string.Join(",", trend.Select(t => "\"" + t.Month + "\"")) + "]" : "[\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\"]";
    var appValues = hasTrend ? "[" + string.Join(",", trend.Select(t => t.Applications)) + "]" : "[22,31,28,44,52,61]";
    var funnel = rec?.Funnel ?? System.Array.Empty<Illumin360.EmployerWeb.Services.CountByLabel>();
    var hasFunnel = funnel.Count > 0;
    var funnelLabels = hasFunnel ? "[" + string.Join(",", funnel.Select(f => "\"" + f.Label + "\"")) + "]" : "[\"Applied\",\"Shortlisted\",\"Hired\"]";
    var funnelValues = hasFunnel ? "[" + string.Join(",", funnel.Select(f => f.Count)) + "]" : "[128,42,17]";
    var statsLive = rec is not null || cand is not null;
}
@if (live)
{
    <div class="card mb-3"><div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h5 class="mb-0 fw-bold">@profile?.CompanyName</h5>
                <span class="badge bg-soft-primary text-primary">Live profile</span>
            </div>
            <div class="text-muted small">@profile?.Industry · @profile?.City</div>
            @if (profile?.About is { Length: > 0 } about)
            {
                <p class="mb-0 mt-1 text-muted" style="max-width:640px;">@about</p>
            }
        </div>
        @if (profile?.Website is { Length: > 0 } site)
        {
            <a class="btn btn-sm btn-soft-primary" href="@site" target="_blank" rel="noopener">Visit website</a>
        }
    </div></div>
}
else
{
    <div class="mb-3"><span class="badge bg-soft-warning text-warning">Demo data</span></div>
}
<div class="d-flex align-items-center gap-2 mb-2">
    <span class="badge @(statsLive ? "bg-soft-primary text-primary" : "bg-soft-warning text-warning")">@(statsLive ? "Live data" : "Demo data")</span>
    <span class="text-muted small text-on-dark-canvas">Open roles, hires, applications trend &amp; pipeline from the Recruitment service; candidate pool from the Candidates service; team from your account.</span>
</div>
<div id="overview" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 mb-3" style="scroll-margin-top:84px;">
    @foreach (var (label, value, sub, icon) in kpis)
    {
        <div class="col">
            <div class="card h-100 mb-0"><div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div><p class="mb-1 text-muted small">@label</p><h4 class="mb-0 fw-bold">@value</h4><span class="text-muted" style="font-size:.72rem;">@sub</span></div>
                    <div class="rounded p-2 bg-soft-primary text-primary d-inline-flex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg></div>
                </div>
            </div></div>
        </div>
    }
</div>
<div class="row g-3 mb-4">
    <div id="applications" class="col-lg-8" style="scroll-margin-top:84px;"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Applications received</h5><small class="text-muted">By month</small></div>
        <div class="card-body"><div id="areaChart"></div></div>
    </div></div>
    <div id="pipeline" class="col-lg-4" style="scroll-margin-top:84px;"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Pipeline</h5></div>
        <div class="card-body d-flex align-items-center justify-content-center"><div id="donutChart"></div></div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
  function primary() { return (window.brandPrimary ? window.brandPrimary() : "#3a57e8"); }
  var charts = [];
  function build() {
    charts.forEach(function (c) { try { c.destroy(); } catch (e) {} }); charts = [];
    var p = primary();
    var a = new ApexCharts(document.querySelector("#areaChart"), {
      chart: { type: "area", height: 300, toolbar: { show: false } }, colors: [p],
      series: [{ name: "Applications", data: @Html.Raw(appValues) }],
      xaxis: { categories: @Html.Raw(appLabels) }, dataLabels: { enabled: false },
      stroke: { curve: "smooth", width: 2.5 }, fill: { type: "gradient", gradient: { opacityFrom: .45, opacityTo: 0 } },
      grid: { borderColor: "#eef0f7" } });
    a.render(); charts.push(a);
    var d = new ApexCharts(document.querySelector("#donutChart"), {
      chart: { type: "donut", height: 260 }, colors: [p, "#e8b14c", "#5ab7ff", "#9b8cff", "#1aa053"],
      series: @Html.Raw(funnelValues), labels: @Html.Raw(funnelLabels),
      legend: { position: "bottom" }, dataLabels: { enabled: false }, plotOptions: { pie: { donut: { size: "68%" } } } });
    d.render(); charts.push(d);
  }
  function start() { if (window.ApexCharts) { build(); } else { setTimeout(start, 60); } }
  start();
  document.addEventListener("brandchange", function () { if (window.ApexCharts) { build(); } });
})();
</script>
}
