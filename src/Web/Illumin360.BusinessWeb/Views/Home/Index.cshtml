@{
    ViewData["Title"] = "Talent Insights";
    var kpis = new[] {
        ("Total Talent", "17,360", "+27% YoY", "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 21a7 7 0 0 1 14 0"),
        ("Active Companies", "1,879", "+26% YoY", "M4 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M9 8h2M9 12h2"),
        ("Hires Placed", "25,514", "+36% YoY", "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"),
        ("Fill Rate", "80.3%", "median 18 days", "M22 12h-4l-3 9L9 3l-3 9H2"),
        ("ARR", "N$13M", "N$1.1M MRR", "M3 6h18v12H3zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"),
    };
}
<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-3">
    @foreach (var (label, value, sub, icon) in kpis)
    {
        <div class="col">
            <div class="card h-100 mb-0"><div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div><p class="mb-1 text-muted small">@label</p><h4 class="mb-0 fw-bold">@value</h4><span class="text-muted" style="font-size:.72rem;">@sub</span></div>
                    <div class="rounded p-2 bg-soft-primary text-primary d-inline-flex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg></div>
                </div>
            </div></div>
        </div>
    }
</div>
<div class="row g-3 mb-4">
    <div class="col-lg-8"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Talent pool growth</h5><small class="text-muted">Cumulative talent &amp; companies · 10Y</small></div>
        <div class="card-body"><div id="growthChart"></div></div>
    </div></div>
    <div class="col-lg-4"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Talent mix</h5></div>
        <div class="card-body d-flex align-items-center justify-content-center"><div id="mixChart"></div></div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
  function primary() { return (window.brandPrimary ? window.brandPrimary() : "#3a57e8"); }
  var charts = [];
  function build() {
    charts.forEach(function (c) { try { c.destroy(); } catch (e) {} }); charts = [];
    var p = primary();
    var a = new ApexCharts(document.querySelector("#growthChart"), {
      chart: { type: "area", height: 300, toolbar: { show: false } }, colors: [p, "#e8b14c"],
      series: [{ name: "Talent", data: [800,2400,5200,9100,13800,17360] }, { name: "Companies", data: [120,380,720,1150,1600,1879] }],
      xaxis: { categories: ["2016","2018","2020","2022","2024","2026"] }, dataLabels: { enabled: false },
      stroke: { curve: "smooth", width: 2 }, fill: { type: "gradient", gradient: { opacityFrom: .4, opacityTo: 0 } },
      legend: { position: "top", horizontalAlign: "right" }, grid: { borderColor: "#eef0f7" } });
    a.render(); charts.push(a);
    var d = new ApexCharts(document.querySelector("#mixChart"), {
      chart: { type: "donut", height: 260 }, colors: [p, "#e8b14c", "#5ab7ff"],
      series: [11800, 5560, 1879], labels: ["Professionals", "Students", "Companies"],
      legend: { position: "bottom" }, dataLabels: { enabled: false }, plotOptions: { pie: { donut: { size: "68%" } } } });
    d.render(); charts.push(d);
  }
  function start() { if (window.ApexCharts) { build(); } else { setTimeout(start, 60); } }
  start();
  document.addEventListener("brandchange", function () { if (window.ApexCharts) { build(); } });
})();
</script>
}
