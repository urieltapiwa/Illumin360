@model Illumin360.BusinessWeb.Services.TalentInsights?
@{
    ViewData["Title"] = "Talent Insights";
    var live = Model is not null;
    var mix = (Model?.Mix is { Length: 2 }) ? Model!.Mix! : new[] { 2, 4 };
    var mixJson = "[" + string.Join(",", mix) + "]";
    var growth = Model?.Growth ?? System.Array.Empty<Illumin360.BusinessWeb.Services.GrowthPoint>();
    var hasGrowth = growth.Length > 0;
    var gLabels = hasGrowth ? "[" + string.Join(",", growth.Select(g => "\"" + g.Label + "\"")) + "]" : "[\"2016\",\"2018\",\"2020\",\"2022\",\"2024\",\"2026\"]";
    var gTalent = hasGrowth ? "[" + string.Join(",", growth.Select(g => g.Talent)) + "]" : "[800,2400,5200,9100,13800,17360]";
    var gCompanies = hasGrowth ? "[" + string.Join(",", growth.Select(g => g.Companies)) + "]" : "[120,380,720,1150,1600,1879]";
    var kpis = new[] {
        ("Total Talent", (Model?.TotalTalent ?? 2).ToString(), "on the platform", "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 21a7 7 0 0 1 14 0"),
        ("Companies", (Model?.TotalCompanies ?? 4).ToString(), $"{Model?.ActiveCompanies ?? 4} active", "M4 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M9 8h2M9 12h2"),
        ("Verified", (Model?.VerifiedEntities ?? 1).ToString(), "entities cleared", "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"),
        ("Pending Review", (Model?.PendingReview ?? 5).ToString(), "in the queue", "M22 12h-4l-3 9L9 3l-3 9H2"),
    };
}
<div class="d-flex align-items-center gap-2 mb-2">
    <span class="badge @(live ? "bg-soft-primary text-primary" : "bg-soft-warning text-warning")">@(live ? "Live data" : "Demo data")</span>
    <span class="text-muted small">Talent, company &amp; verification counts and the growth trend are live from the platform.</span>
</div>
<div id="overview" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 mb-3" style="scroll-margin-top:84px;">
    @foreach (var (label, value, sub, icon) in kpis)
    {
        <div class="col">
            <div class="card h-100 mb-0"><div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div><p class="mb-1 text-muted small">@label</p><h4 class="mb-0 fw-bold">@value</h4><span class="text-muted" style="font-size:.72rem;">@sub</span></div>
                    <div class="rounded p-2 bg-soft-primary text-primary d-inline-flex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg></div>
                </div>
            </div></div>
        </div>
    }
</div>
<div class="row g-3 mb-4">
    <div id="growth" class="col-lg-8" style="scroll-margin-top:84px;"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Talent pool growth</h5><small class="text-muted">Cumulative talent &amp; companies · last 6 months</small></div>
        <div class="card-body"><div id="growthChart"></div></div>
    </div></div>
    <div id="mix" class="col-lg-4" style="scroll-margin-top:84px;"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Talent mix</h5></div>
        <div class="card-body d-flex align-items-center justify-content-center"><div id="mixChart"></div></div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
  function primary() { return (window.brandPrimary ? window.brandPrimary() : "#3a57e8"); }
  var charts = [];
  function build() {
    charts.forEach(function (c) { try { c.destroy(); } catch (e) {} }); charts = [];
    var p = primary();
    var a = new ApexCharts(document.querySelector("#growthChart"), {
      chart: { type: "area", height: 300, toolbar: { show: false } }, colors: [p, "#e8b14c"],
      series: [{ name: "Talent", data: @Html.Raw(gTalent) }, { name: "Companies", data: @Html.Raw(gCompanies) }],
      xaxis: { categories: @Html.Raw(gLabels) }, dataLabels: { enabled: false },
      stroke: { curve: "smooth", width: 2 }, fill: { type: "gradient", gradient: { opacityFrom: .4, opacityTo: 0 } },
      legend: { position: "top", horizontalAlign: "right" }, grid: { borderColor: "#eef0f7" } });
    a.render(); charts.push(a);
    var d = new ApexCharts(document.querySelector("#mixChart"), {
      chart: { type: "donut", height: 260 }, colors: [p, "#e8b14c"],
      series: @Html.Raw(mixJson), labels: ["Talent", "Companies"],
      legend: { position: "bottom" }, dataLabels: { enabled: false }, plotOptions: { pie: { donut: { size: "68%" } } } });
    d.render(); charts.push(d);
  }
  function start() { if (window.ApexCharts) { build(); } else { setTimeout(start, 60); } }
  start();
  document.addEventListener("brandchange", function () { if (window.ApexCharts) { build(); } });
})();
</script>
}
