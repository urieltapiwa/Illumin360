<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Illumin360.BusinessWeb</RootNamespace>
    <UserSecretsId>illumin360-businessweb</UserSecretsId>
    <!-- Presentation (MVC) project: XML-doc + file-header rules suit library code, not views/
         controllers. Security/quality analyzers (CA*, nullable, code style) stay enforced. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA0001;SA1600;SA1601;SA1633</NoWarn>
  </PropertyGroup>

</Project>
