@model IReadOnlyList<Illumin360.AdminWeb.Services.AuditRow>
@{
    ViewData["Title"] = "Audit trail";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <span class="text-muted small">Administrative actions, newest first.</span>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Audit trail</h5>
        <span class="badge bg-soft-primary text-primary">@Model.Count entries</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>When (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Summary</th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No audit entries yet.</td></tr>
                }
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="text-muted" style="white-space:nowrap;">@e.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="fw-semibold">@e.Actor</td>
                        <td><span class="badge bg-soft-primary text-primary">@e.Action</span></td>
                        <td class="text-muted">@e.EntityType@(string.IsNullOrWhiteSpace(e.EntityId) ? "" : $" · {e.EntityId}")</td>
                        <td class="text-muted">@e.Summary</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
