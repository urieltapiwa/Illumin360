@model Illumin360.AdminWeb.Services.AdminSummary?
@{
    ViewData["Title"] = "Platform Command";
    var live = Model is not null;
    var mix = (Model?.AccountMix is { Length: 2 }) ? Model!.AccountMix! : new[] { 4, 2 };
    var segmentJson = "[" + string.Join(",", mix) + "]";
    var growth = Model?.Growth ?? System.Array.Empty<Illumin360.AdminWeb.Services.GrowthPoint>();
    var hasGrowth = growth.Length > 0;
    var gLabels = hasGrowth ? "[" + string.Join(",", growth.Select(g => "\"" + g.Label + "\"")) + "]" : "[\"2016\",\"2018\",\"2020\",\"2022\",\"2024\",\"2026\"]";
    var gTalent = hasGrowth ? "[" + string.Join(",", growth.Select(g => g.Talent)) + "]" : "[800,2400,5200,9100,13800,17360]";
    var gCompanies = hasGrowth ? "[" + string.Join(",", growth.Select(g => g.Companies)) + "]" : "[120,380,720,1150,1600,1879]";
    var regions = Model?.Regions ?? System.Array.Empty<Illumin360.AdminWeb.Services.RegionPoint>();
    var hasRegions = regions.Length > 0;
    var rLabels = hasRegions ? "[" + string.Join(",", regions.Select(r => "\"" + r.Region + "\"")) + "]" : "[\"Windhoek\",\"Walvis Bay\",\"Swakopmund\",\"Oshakati\",\"Rundu\"]";
    var rCounts = hasRegions ? "[" + string.Join(",", regions.Select(r => r.Count)) + "]" : "[5884,1717,1404,1371,1037]";
    var mrrLabels = (ViewData["MrrLabels"] as string) ?? "[\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\"]";
    var mrrValues = (ViewData["MrrValues"] as string) ?? "[180000,320000,470000,610000,780000,940000,1100000]";
    var mrrCcy = (ViewData["MrrCurrency"] as string) ?? "NAD";
    var kpis = new[] {
        ("Total Accounts", (Model?.TotalAccounts ?? 6).ToString(), $"{Model?.ActiveAccounts ?? 6} active", "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 21a7 7 0 0 1 14 0"),
        ("Companies", (Model?.Companies ?? 4).ToString(), "on the platform", "M4 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M9 8h2M9 12h2M9 16h2"),
        ("Talent", (Model?.Talent ?? 2).ToString(), "candidates & pros", "M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"),
        ("Suspended", (Model?.SuspendedAccounts ?? 0).ToString(), "access revoked", "M18.36 6.64A9 9 0 1 1 5.64 5.64M12 2v10"),
        ("Pending Verifications", (Model?.PendingVerifications ?? 5).ToString(), "awaiting review", "M22 12h-4l-3 9L9 3l-3 9H2"),
        ("Open Tickets", (Model?.OpenTickets ?? 4).ToString(), "in the support queue", "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"),
    };
    var services = new[] {
        ("Gateway", "38ms", "99.99%", true),
        ("Candidates", "52ms", "99.98%", true),
        ("Recruitment / AI Match", "119ms", "99.95%", true),
        ("Billing", "61ms", "99.99%", true),
        ("Notifications", "248ms", "99.82%", false),
        ("Identity (Keycloak)", "44ms", "99.99%", true),
    };
    var queue = new[] {
        ("Etosha Consulting", "Company verification", "34s ago", "Low"),
        ("Apex Namibia", "Recruiter ID", "12s ago", "Low"),
        ("Meridian Group", "Company verification", "5h ago", "Medium"),
        ("Orange River Trading", "Document review", "3h ago", "Low"),
        ("Erongo Consulting", "Company verification", "3h ago", "Medium"),
    };
}

<div class="d-flex align-items-center gap-2 mb-2">
    <span class="badge @(live ? "bg-soft-primary text-primary" : "bg-soft-warning text-warning")">@(live ? "Live data" : "Demo data")</span>
    <span class="text-muted small">All live: accounts, verifications, tickets &amp; growth from the Admin service, MRR from Billing, regional splits from the account directory.</span>
</div>

<!-- KPI cards -->
<div id="overview" class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3 mb-3" style="scroll-margin-top:84px;">
    @foreach (var (label, value, sub, icon) in kpis)
    {
        <div class="col">
            <div class="card h-100 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <p class="mb-1 text-muted small">@label</p>
                            <h4 class="mb-0 fw-bold">@value</h4>
                            <span class="text-muted" style="font-size:.72rem;">@sub</span>
                        </div>
                        <div class="rounded p-2 bg-soft-primary text-primary d-inline-flex">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Growth + segments -->
<div id="growth" class="row g-3 mb-3" style="scroll-margin-top:84px;">
    <div class="col-lg-8">
        <div class="card mb-0 h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div><h5 class="mb-0 fw-bold">Platform growth</h5><small class="text-muted">Cumulative talent &amp; companies · last 6 months</small></div>
            </div>
            <div class="card-body"><div id="growthChart"></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-0 h-100">
            <div class="card-header"><h5 class="mb-0 fw-bold">User segments</h5></div>
            <div class="card-body d-flex align-items-center justify-content-center"><div id="segmentChart"></div></div>
        </div>
    </div>
</div>

<!-- Revenue + system health -->
<div id="revenue" class="row g-3 mb-3" style="scroll-margin-top:84px;">
    <div class="col-lg-8">
        <div class="card mb-0 h-100">
            <div class="card-header"><h5 class="mb-0 fw-bold">Recurring revenue</h5><small class="text-muted">Platform MRR</small></div>
            <div class="card-body"><div id="revenueChart"></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-0 h-100">
            <div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0 fw-bold">System health</h5><span class="badge bg-soft-primary text-primary">live</span></div>
            <div class="card-body">
                @foreach (var (name, latency, uptime, ok) in services)
                {
                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                        <span class="d-flex align-items-center gap-2"><span class="rounded-circle d-inline-block" style="width:8px;height:8px;background:@(ok ? "#1aa053" : "#e8b14c")"></span>@name</span>
                        <span class="text-muted small">@latency · <span class="@(ok ? "" : "text-warning")">@uptime</span></span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Verification queue + talent by region -->
<div id="verifications" class="row g-3 mb-4" style="scroll-margin-top:84px;">
    <div class="col-lg-8">
        <div class="card mb-0 h-100">
            <div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0 fw-bold">Verification queue</h5><span class="badge bg-soft-primary text-primary">@(Model?.PendingVerifications ?? 5) pending</span></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Entity</th><th>Type</th><th>Submitted</th><th>Risk</th><th class="text-end">Action</th></tr></thead>
                        <tbody>
                            @foreach (var (entity, type, submitted, risk) in queue)
                            {
                                <tr>
                                    <td class="fw-semibold">@entity</td>
                                    <td class="text-muted">@type</td>
                                    <td class="text-muted">@submitted</td>
                                    <td><span class="badge @(risk == "Medium" ? "bg-soft-warning text-warning" : "bg-soft-primary text-primary")">@risk</span></td>
                                    <td class="text-end"><a href="#" class="btn btn-sm btn-soft-primary">Review</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div id="regions" class="col-lg-4" style="scroll-margin-top:84px;">
        <div class="card mb-0 h-100">
            <div class="card-header"><h5 class="mb-0 fw-bold">Accounts by region</h5></div>
            <div class="card-body"><div id="regionChart"></div></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
  function primary() { return (window.brandPrimary ? window.brandPrimary() : "#3a57e8"); }
  var charts = [];
  function build() {
    charts.forEach(function (c) { try { c.destroy(); } catch (e) {} });
    charts = [];
    var p = primary();
    charts.push(new ApexCharts(document.querySelector("#growthChart"), {
      chart: { type: "area", height: 300, toolbar: { show: false } },
      colors: [p, "#e8b14c"],
      series: [{ name: "Talent", data: @Html.Raw(gTalent) },
               { name: "Companies", data: @Html.Raw(gCompanies) }],
      xaxis: { categories: @Html.Raw(gLabels) }, dataLabels: { enabled: false },
      stroke: { curve: "smooth", width: 2 }, fill: { type: "gradient", gradient: { opacityFrom: .4, opacityTo: 0 } },
      legend: { position: "top", horizontalAlign: "right" }, grid: { borderColor: "#eef0f7" }
    }));
    charts[charts.length-1].render();

    charts.push(new ApexCharts(document.querySelector("#segmentChart"), {
      chart: { type: "donut", height: 260 }, colors: [p, "#e8b14c"],
      series: @Html.Raw(segmentJson), labels: ["Companies", "Talent"],
      legend: { position: "bottom" }, dataLabels: { enabled: false },
      plotOptions: { pie: { donut: { size: "68%" } } }
    }));
    charts[charts.length-1].render();

    charts.push(new ApexCharts(document.querySelector("#revenueChart"), {
      chart: { type: "area", height: 300, toolbar: { show: false } }, colors: [p],
      series: [{ name: "MRR (@mrrCcy)", data: @Html.Raw(mrrValues) }],
      xaxis: { categories: @Html.Raw(mrrLabels) }, dataLabels: { enabled: false },
      stroke: { curve: "smooth", width: 2.5 }, fill: { type: "gradient", gradient: { opacityFrom: .45, opacityTo: 0 } },
      grid: { borderColor: "#eef0f7" }
    }));
    charts[charts.length-1].render();

    charts.push(new ApexCharts(document.querySelector("#regionChart"), {
      chart: { type: "bar", height: 300, toolbar: { show: false } }, colors: [p],
      series: [{ name: "Accounts", data: @Html.Raw(rCounts) }],
      xaxis: { categories: @Html.Raw(rLabels) },
      plotOptions: { bar: { horizontal: true, borderRadius: 4, barHeight: "60%" } },
      dataLabels: { enabled: false }, grid: { borderColor: "#eef0f7" }
    }));
    charts[charts.length-1].render();
  }
  function start() { if (window.ApexCharts) { build(); } else { setTimeout(start, 60); } }
  start();
  document.addEventListener("brandchange", function () { if (window.ApexCharts) { build(); } });
})();
</script>
}
