<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Illumin360</title>
    <link rel="stylesheet" href="~/hopeui/fonts/inter.css" />
    <link rel="stylesheet" href="~/hopeui/css/core/libs.min.css" />
    <link rel="stylesheet" href="~/hopeui/css/hope-ui.min.css" />
    <link rel="stylesheet" href="~/hopeui/css/custom.min.css" />
    <link rel="stylesheet" href="~/hopeui/brand.css" />
    <script src="~/hopeui/js/theme.js"></script>
</head>
<body>
    @{ var _uname = (User.Identity?.Name) ?? "Account"; var _uinit = string.Concat(_uname.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0]))); }
    @{
        var _path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
        bool _active(string href) => href == "/" ? _path == "/" : _path.StartsWith(href.ToLowerInvariant(), StringComparison.Ordinal);
        var nav = new[] {
            ("Dashboard", "/", _active("/"), "M4 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M9 8h2M9 12h2M9 16h2M16 10h3a1 1 0 0 1 1 1v10"),
            ("Accounts", "/Accounts", _active("/Accounts"), "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 21a7 7 0 0 1 14 0M19 21a5 5 0 0 0-6-4.9"),
            ("Verifications", "/Verifications", _active("/Verifications"), "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"),
            ("Tickets", "/Tickets", _active("/Tickets"), "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"),
            ("Audit", "/Audit", _active("/Audit"), "M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"),
        };
    }
    <aside class="sidebar sidebar-default sidebar-white sidebar-base navs-rounded-all">
        <div class="sidebar-header d-flex align-items-center justify-content-start">
            <a href="/" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none">
                <span class="logo-main d-inline-flex">
                    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                        <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="1.8" />
                        <circle cx="16" cy="16" r="8.5" stroke="currentColor" stroke-width="1.8" opacity=".6" />
                        <circle cx="16" cy="16" r="3" fill="#E8B14C" />
                    </svg>
                </span>
                <h5 class="logo-title mb-0 fw-bold">Illumin<span class="brand-360">360</span></h5>
            </a>
        </div>
        <div class="sidebar-body pt-0 data-scrollbar">
            <div class="sidebar-list">
                <ul class="navbar-nav iq-main-menu" id="sidebar-menu">
                    <li class="nav-item static-item"><span class="nav-link static-item disabled"><span class="default-icon">Platform</span></span></li>
                    @foreach (var (name, href, active, path) in nav)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(active ? "active" : "")" href="@href">
                                <i class="icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@path" /></svg></i>
                                <span class="item-name">@name</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="sidebar-footer"></div>
    </aside>

    <main class="main-content">
        <nav class="nav navbar navbar-expand-lg navbar-light iq-navbar">
            <div class="container-fluid navbar-inner">
                <div>
                    <h4 class="mb-0 fw-bold">@(ViewData["Title"] ?? "Platform Command")</h4>
                    <small class="text-muted">Operations, growth, revenue and system health across Illumin360.</small>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="status-live"><span class="dot"></span> LIVE</span>
                    <button id="brandToggle" type="button" class="btn btn-sm btn-primary">Theme: <span id="brandLabel">HopeUI Blue</span></button>
                    <span class="d-flex align-items-center gap-2"><span class="avatar-initials rounded d-inline-flex align-items-center justify-content-center bg-soft-primary text-primary fw-bold" style="width:38px;height:38px;">@_uinit</span><span class="small text-muted d-none d-lg-inline">@_uname</span></span><form action="/auth/logout" method="post" class="m-0 d-inline"><button type="submit" class="btn btn-sm btn-soft-primary">Sign out</button></form>
                </div>
            </div>
        </nav>

        <div class="container-fluid content-inner pb-0 mt-4">
            @RenderBody()
        </div>
    </main>

    <script src="~/hopeui/js/libs.min.js"></script>
    <script src="~/hopeui/js/external.min.js"></script>
    <script src="~/hopeui/js/hope-ui.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
