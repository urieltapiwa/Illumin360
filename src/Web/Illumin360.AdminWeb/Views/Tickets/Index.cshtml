@model IReadOnlyList<Illumin360.AdminWeb.Services.TicketRow>
@{
    ViewData["Title"] = "Tickets";
    var status = (ViewData["Status"] as string) ?? "open";
    string Pill(string s) => string.Equals(status, s, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-soft-primary";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="text-muted small me-2">Support queue — triage and resolve.</span>
    <a class="btn btn-sm @Pill("open")" href="/Tickets?status=open">Open</a>
    <a class="btn btn-sm @Pill("assigned")" href="/Tickets?status=assigned">Assigned</a>
    <a class="btn btn-sm @Pill("resolved")" href="/Tickets?status=resolved">Resolved</a>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-capitalize">@status tickets</h5>
        <span class="badge bg-soft-primary text-primary">@Model.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>Subject</th><th>Priority</th><th>Requester</th><th>Assignee</th><th class="text-end">Action</th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No @status tickets.</td></tr>
                }
                @foreach (var t in Model)
                {
                    var resolved = string.Equals(t.Status, "resolved", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td class="fw-semibold">@t.Subject</td>
                        <td><span class="badge @(string.Equals(t.Priority,"P1",StringComparison.OrdinalIgnoreCase) ? "bg-soft-danger text-danger" : string.Equals(t.Priority,"P2",StringComparison.OrdinalIgnoreCase) ? "bg-soft-warning text-warning" : "bg-soft-primary text-primary")">@t.Priority</span></td>
                        <td class="text-muted">@t.Requester</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(t.Assignee) ? "—" : t.Assignee)</td>
                        <td class="text-end">
                            @if (!resolved)
                            {
                                <form asp-controller="Tickets" asp-action="Assign" method="post" class="m-0 d-inline">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm btn-soft-primary">Assign to me</button>
                                </form>
                                <form asp-controller="Tickets" asp-action="Resolve" method="post" class="m-0 d-inline ms-1">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm btn-soft-success">Resolve</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-soft-success text-success">Resolved</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
