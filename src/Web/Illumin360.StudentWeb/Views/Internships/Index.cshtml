@model IReadOnlyList<Illumin360.StudentWeb.Services.StudentMatch>
@{
    ViewData["Title"] = "Internships";
    var options = new[] { "Open to opportunities", "Actively looking", "Not available" };
}

@if (TempData["Msg"] is string msg)
{
    <div class="alert alert-soft-primary py-2 mb-3">@msg</div>
}

<div class="card mb-3"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div><span class="fw-semibold">Your availability</span><div class="text-muted small">Employers see this on your profile.</div></div>
    <form asp-controller="Internships" asp-action="SetAvailability" method="post" class="d-flex gap-2 m-0">
        <select name="availability" class="form-select form-select-sm" style="width:auto;">
            @foreach (var o in options) { <option value="@o">@o</option> }
        </select>
        <button type="submit" class="btn btn-sm btn-primary">Update</button>
    </form>
</div></div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Matched internships</h5>
        <span class="badge bg-soft-primary text-primary">@Model.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>Role</th><th>Company</th><th>Location</th><th>Stipend</th><th>Match</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No internship matches yet.</td></tr>
                }
                @foreach (var m in Model)
                {
                    var applied = string.Equals(m.Status, "applied", StringComparison.OrdinalIgnoreCase);
                    var dismissed = string.Equals(m.Status, "dismissed", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td class="fw-semibold">@m.Role</td>
                        <td class="text-muted">@m.Company</td>
                        <td class="text-muted">@m.City</td>
                        <td class="text-muted">N$@m.StipendLo.ToString("N0")–@m.StipendHi.ToString("N0")</td>
                        <td><span class="badge @(m.Match >= 60 ? "bg-soft-success text-success" : m.Match >= 30 ? "bg-soft-warning text-warning" : "bg-soft-secondary text-secondary")">@m.Match%</span></td>
                        <td class="text-end">
                            @if (applied)
                            {
                                <span class="badge bg-soft-success text-success">Applied</span>
                            }
                            else if (dismissed)
                            {
                                <span class="badge bg-soft-secondary text-secondary">Dismissed</span>
                            }
                            else
                            {
                                <form asp-controller="Internships" asp-action="Act" method="post" class="m-0 d-inline">
                                    <input type="hidden" name="id" value="@m.Id" /><input type="hidden" name="action" value="apply" />
                                    <button type="submit" class="btn btn-sm btn-soft-success">Apply</button>
                                </form>
                                <form asp-controller="Internships" asp-action="Act" method="post" class="m-0 d-inline ms-1">
                                    <input type="hidden" name="id" value="@m.Id" /><input type="hidden" name="action" value="save" />
                                    <button type="submit" class="btn btn-sm btn-soft-primary">Save</button>
                                </form>
                                <form asp-controller="Internships" asp-action="Act" method="post" class="m-0 d-inline ms-1">
                                    <input type="hidden" name="id" value="@m.Id" /><input type="hidden" name="action" value="dismiss" />
                                    <button type="submit" class="btn btn-sm btn-soft-danger">Dismiss</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
