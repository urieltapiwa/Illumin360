@model Illumin360.StudentWeb.Services.StudentDashboard?
@{
    ViewData["Title"] = "My Path";
    var k = Model?.Kpis;
    var live = Model is not null;
    int readiness = k?.Readiness ?? 78;
    int views = k?.ProfileViews ?? 76;
    int matches = k?.InternshipMatches ?? 6;
    int applications = k?.Applications ?? 4;
    int modules = k?.SkillsDone ?? 2;
    var trend = (Model?.ViewsTrend is { Length: > 0 } vt) ? vt : new[] { 8, 11, 9, 14, 18, 22, 28, 34 };
    var learning = Model?.Learning ?? System.Array.Empty<Illumin360.StudentWeb.Services.Learning>();
    int lDone = learning.Count(l => string.Equals(l.Tag, "done", System.StringComparison.OrdinalIgnoreCase));
    int lProg = learning.Count(l => (l.Tag ?? "").Contains("progress", System.StringComparison.OrdinalIgnoreCase));
    int lRest = System.Math.Max(learning.Length - lDone - lProg, 0);
    if (learning.Length == 0) { lDone = 6; lProg = 3; lRest = 2; }
    var trendJson = "[" + string.Join(",", trend) + "]";
    var donutJson = $"[{lDone},{lProg},{lRest}]";
    var kpis = new (string, string, string, string)[] {
        ("Career Readiness", $"{readiness}%", "final year", "M13 2 3 14h7l-1 8 10-12h-7z"),
        ("Profile Views", views.ToString(), $"+{k?.ViewsDelta ?? 9} this week", "M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"),
        ("Internship Matches", matches.ToString(), "open now", "M3 8h18v12H3zM8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"),
        ("Applications", applications.ToString(), $"{k?.MentorSessions ?? 3} mentor chats", "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"),
        ("Modules Done", modules.ToString(), "keep going", "M4 19V5a1 1 0 0 1 1-1h13v15H6a2 2 0 0 0-2 2zM18 4v17"),
    };
}

<div class="d-flex align-items-center gap-2 mb-2">
    <span class="badge @(live ? "bg-soft-primary text-primary" : "bg-soft-warning text-warning")">@(live ? "Live data" : "Demo data")</span>
    @if (live && Model?.Persona?.Name is { Length: > 0 } nm)
    {
        <span class="text-muted small">@nm · @Model?.Persona?.School</span>
    }
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-3">
    @foreach (var (label, value, sub, icon) in kpis)
    {
        <div class="col">
            <div class="card h-100 mb-0"><div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div><p class="mb-1 text-muted small">@label</p><h4 class="mb-0 fw-bold">@value</h4><span class="text-muted" style="font-size:.72rem;">@sub</span></div>
                    <div class="rounded p-2 bg-soft-primary text-primary d-inline-flex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg></div>
                </div>
            </div></div>
        </div>
    }
</div>
<div class="row g-3 mb-4">
    <div class="col-lg-8"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Profile views</h5><small class="text-muted">Recent trend</small></div>
        <div class="card-body"><div id="areaChart"></div></div>
    </div></div>
    <div class="col-lg-4"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Learning</h5></div>
        <div class="card-body d-flex align-items-center justify-content-center"><div id="donutChart"></div></div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
  function primary() { return (window.brandPrimary ? window.brandPrimary() : "#3a57e8"); }
  var charts = [];
  function build() {
    charts.forEach(function (c) { try { c.destroy(); } catch (e) {} }); charts = [];
    var p = primary();
    var a = new ApexCharts(document.querySelector("#areaChart"), {
      chart: { type: "area", height: 300, toolbar: { show: false } }, colors: [p],
      series: [{ name: "Views", data: @Html.Raw(trendJson) }],
      dataLabels: { enabled: false }, stroke: { curve: "smooth", width: 2.5 },
      fill: { type: "gradient", gradient: { opacityFrom: .45, opacityTo: 0 } }, grid: { borderColor: "#eef0f7" },
      xaxis: { labels: { show: false } } });
    a.render(); charts.push(a);
    var d = new ApexCharts(document.querySelector("#donutChart"), {
      chart: { type: "donut", height: 260 }, colors: [p, "#e8b14c", "#5ab7ff"],
      series: @Html.Raw(donutJson), labels: ["Done", "In progress", "Not started"],
      legend: { position: "bottom" }, dataLabels: { enabled: false }, plotOptions: { pie: { donut: { size: "68%" } } } });
    d.render(); charts.push(d);
  }
  function start() { if (window.ApexCharts) { build(); } else { setTimeout(start, 60); } }
  start();
  document.addEventListener("brandchange", function () { if (window.ApexCharts) { build(); } });
})();
</script>
}
