@inherits LayoutComponentBase

<aside class="sidebar sidebar-default sidebar-white sidebar-base navs-rounded-all">
    <div class="sidebar-header d-flex align-items-center justify-content-start">
        <a href="/employer" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none">
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <circle cx="16" cy="16" r="14" stroke="#1FB283" stroke-width="1.7" />
                <circle cx="16" cy="16" r="8.5" stroke="#2FD39A" stroke-width="1.7" />
                <circle cx="16" cy="16" r="3" fill="#E8B14C" />
            </svg>
            <h5 class="logo-title mb-0">Illumin<span class="brand-360">360</span></h5>
        </a>
    </div>
    <div class="sidebar-body pt-0 data-scrollbar">
        <div class="sidebar-list">
            <ul class="navbar-nav iq-main-menu" id="sidebar-menu">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/employer" Match="NavLinkMatch.All">
                        <i class="icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M9 8h2M9 12h2M9 16h2M16 10h3a1 1 0 0 1 1 1v10" /></svg>
                        </i>
                        <span class="item-name">Profile</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/employer/team">
                        <i class="icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 21a7 7 0 0 1 14 0M19 21a5 5 0 0 0-6-4.9" /></svg>
                        </i>
                        <span class="item-name">Team &amp; Roles</span>
                    </NavLink>
                </li>
            </ul>
        </div>
    </div>
    <div class="sidebar-footer"></div>
</aside>

<main class="main-content">
    <nav class="nav navbar navbar-expand-lg navbar-light iq-navbar">
        <div class="container-fluid navbar-inner">
            <div>
                <h4 class="mb-0 fw-bold">Employer workspace</h4>
                <small class="text-muted">Manage how your company appears to candidates.</small>
            </div>
            <div class="ms-auto d-flex align-items-center gap-3">
                <span class="status-live"><span class="pulse"></span> LIVE</span>
                <AuthorizeView>
                    <Authorized>
                        <span class="d-flex align-items-center gap-2">
                            <span class="avatar-initials">@Initials(context.User.Identity?.Name)</span>
                            <span class="small text-muted d-none d-md-inline">@context.User.Identity?.Name</span>
                        </span>
                        <form action="/auth/logout" method="post" data-enhance="false" class="m-0">
                            <AntiforgeryToken />
                            <button class="btn btn-sm btn-soft-primary" type="submit">Sign out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-sm btn-primary" href="/auth/login?returnUrl=/employer/team">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <div class="container-fluid content-inner py-4">
        @Body
    </div>
</main>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();
    }
}
