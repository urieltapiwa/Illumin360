@model Illumin360.ProfessionalWeb.Services.ProfessionalDashboard?
@{
    ViewData["Title"] = "Career";
    var k = Model?.Kpis;
    var live = Model is not null;
    int strength = Model?.Persona?.ProfileStrength ?? 82;
    int matches = k?.MatchOpportunities ?? 14;
    int apps = k?.ActiveApplications ?? 7;
    int views = k?.ProfileViews ?? 120;
    int interviews = k?.Interviews ?? 3;
    var trend = (Model?.ViewsTrend is { Length: > 0 } vt) ? vt : new[] { 4, 6, 7, 9, 11, 14 };
    var trendJson = "[" + string.Join(",", trend) + "]";
    var kpis = new (string, string, string, string)[] {
        ("Profile Strength", $"{strength}%", $"top {Model?.Persona?.Percentile ?? 15}%", "M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"),
        ("Role Matches", matches.ToString(), $"+{k?.MatchDelta ?? 0} this week", "M3 8h18v12H3zM8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"),
        ("Applications", apps.ToString(), $"{interviews} interviews", "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"),
        ("Profile Views", views.ToString(), $"+{k?.ViewsDelta ?? 0} this week", "M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"),
    };
    int avg = k?.AvgMatch ?? 15;
    int resp = k?.ResponseRate ?? 60;
    var donutJson = $"[{resp},{Math.Max(avg, 1)},{Math.Max(100 - resp - avg, 0)}]";
}

<div class="d-flex align-items-center gap-2 mb-2">
    <span class="badge @(live ? "bg-soft-primary text-primary" : "bg-soft-warning text-warning")">@(live ? "Live data" : "Demo data")</span>
    @if (live && Model?.Persona?.Name is { Length: > 0 } nm)
    {
        <span class="text-muted small">@nm · @Model?.Persona?.Headline</span>
    }
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 mb-3">
    @foreach (var (label, value, sub, icon) in kpis)
    {
        <div class="col">
            <div class="card h-100 mb-0"><div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div><p class="mb-1 text-muted small">@label</p><h4 class="mb-0 fw-bold">@value</h4><span class="text-muted" style="font-size:.72rem;">@sub</span></div>
                    <div class="rounded p-2 bg-soft-primary text-primary d-inline-flex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg></div>
                </div>
            </div></div>
        </div>
    }
</div>
<div class="row g-3 mb-4">
    <div class="col-lg-8"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Profile-view trend</h5><small class="text-muted">Recent activity</small></div>
        <div class="card-body"><div id="areaChart"></div></div>
    </div></div>
    <div class="col-lg-4"><div class="card mb-0 h-100">
        <div class="card-header"><h5 class="mb-0 fw-bold">Engagement</h5></div>
        <div class="card-body d-flex align-items-center justify-content-center"><div id="donutChart"></div></div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
  function primary() { return (window.brandPrimary ? window.brandPrimary() : "#3a57e8"); }
  var charts = [];
  function build() {
    charts.forEach(function (c) { try { c.destroy(); } catch (e) {} }); charts = [];
    var p = primary();
    var a = new ApexCharts(document.querySelector("#areaChart"), {
      chart: { type: "area", height: 300, toolbar: { show: false } }, colors: [p],
      series: [{ name: "Views", data: @Html.Raw(trendJson) }],
      dataLabels: { enabled: false }, stroke: { curve: "smooth", width: 2.5 },
      fill: { type: "gradient", gradient: { opacityFrom: .45, opacityTo: 0 } }, grid: { borderColor: "#eef0f7" },
      xaxis: { labels: { show: false } } });
    a.render(); charts.push(a);
    var d = new ApexCharts(document.querySelector("#donutChart"), {
      chart: { type: "donut", height: 260 }, colors: [p, "#e8b14c", "#5ab7ff"],
      series: @Html.Raw(donutJson), labels: ["Response rate", "Avg match", "Other"],
      legend: { position: "bottom" }, dataLabels: { enabled: false }, plotOptions: { pie: { donut: { size: "68%" } } } });
    d.render(); charts.push(d);
  }
  function start() { if (window.ApexCharts) { build(); } else { setTimeout(start, 60); } }
  start();
  document.addEventListener("brandchange", function () { if (window.ApexCharts) { build(); } });
})();
</script>
}
